{
    "name": "arnauddelgerie/tfs-app-bundle",
    "description": "Symfony bundle for apps run by TFSAppHub, a host that installs and runs Symfony apps as local desktop apps.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "desktop-app",
        "local-first",
        "tfsapp",
        "tfsapphub"
    ],
    "homepage": "https://github.com/ArnaudDelgerie/TFSAppBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Arnaud Delgerie"
        }
    ],
    "support": {
        "issues": "https://github.com/ArnaudDelgerie/TFSAppBundle/issues",
        "source": "https://github.com/ArnaudDelgerie/TFSAppBundle"
    },
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/http-foundation": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/http-client": "^7.4|^8.0"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "phpunit/phpunit": "^11.0",
        "symfony/twig-bundle": "^7.4|^8.0"
    },
    "suggest": {
        "doctrine/dbal": "To register the SQLite WAL/busy_timeout pragma middleware (sqlite_pragmas)",
        "symfony/twig-bundle": "To expose the tfsapp Twig global (hub context/capability flags for templates)"
    },
    "autoload": {
        "psr-4": {
            "ArnaudDelgerie\\TFSAppBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArnaudDelgerie\\TFSAppBundle\\Tests\\": "tests/"
        }
    }
}
